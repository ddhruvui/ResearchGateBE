# Copy to .env for local runs (`npm run dev`). On Vercel set the same keys under
# Project -> Settings -> Environment Variables. Never commit .env.

# Keep the <db_password> placeholder: it is replaced with DB_PASSWORD, URL-encoded.
DB_PASSWORD=
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster-host>/?appName=Cluster0
MONGO_DB=ResearchGate

# Run served by default; any endpoint accepts ?run=<id> to pick another.
RUN_ID=pso_lssvm_v1

# Browser origins allowed to call the API, comma-separated. * = any (the data
# is public and read-only). Tighten to the Render URL once it exists, e.g.
# ALLOWED_ORIGINS=https://researchgatefe.onrender.com
ALLOWED_ORIGINS=*

# EODHD token, for /api/live-price (the price button on "Tomorrow's prediction").
# Same token as EODHD_API_TOKEN in the ResearchGate repo's .env. Leave blank and
# that one endpoint answers 503; the rest of the dashboard is unaffected.
EODHD_API_TOKEN=

# Seconds Vercel's edge may cache a response (data changes once a day).
EDGE_CACHE_S=60

# Local port only; Vercel ignores it.
PORT=8891
